{
  "domain": "shellyelevateintegration",
  "name": "Shelly Elevate",
  "after_dependencies": [
    "assist_pipeline",
    "assist_satellite",
    "frontend",
    "intent",
    "media_source",
    "panel_custom"
  ],
  "codeowners": [
    "@RapierXbox"
  ],
  "config_flow": true,
  "dependencies": [
    "bluetooth",
    "http",
    "websocket_api"
  ],
  "documentation": "https://github.com/RapierXbox/shellyelevateintegration",
  "integration_type": "device",
  "iot_class": "local_push",
  "issue_tracker": "https://github.com/RapierXbox/shellyelevateintegration/issues",
  "loggers": [
    "custom_components.shellyelevateintegration",
    "adb_shell"
  ],
  "requirements": [
    "adb-shell[async]>=0.4.4"
  ],
  "version": "0.1.9",
  "zeroconf": [
    "_shellyelevate._tcp.local.",
    {
      "type": "_shelly._tcp.local.",
      "name": "shellywalldisplay*"
    }
  ]
}
